@model Product
@{
ViewData["Title"] = "Edit";
}

<form asp-controller="Home" asp-action="Edit" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All"></div>


    <div class="mb-3">
        <label asp-for="CategoryId" class="m-2">Kategori</label>
        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
            <option value="">Seçin</option>
        </select>
        <span asp-validation-for="CategoryId"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Name" class="m-2">Ürün adı</label>
        <input class="form-control" asp-for="Name" placeholder="Ürün Adını Girin" />
        <span asp-validation-for="Name"></span>

    </div>
    <div class="mb-3">
        <label asp-for="Price" class="m-2">Fiyat</label>
        <input class="form-control" asp-for="Price" placeholder="Fiyatı Girin" />
        <span asp-validation-for="Price"></span>

    </div>

    <div class="input-group mb-3">
        <input type="file" name="imageFile" id="imageFile" class="form-control" />
    </div>
    <div>
        <img src="~/img/@Model.Image" alt="" style="width: 100px;">
        <input type="hidden" asp-for="@Model.Image" />
    </div>

    <div class="mb-3 form-check">
        <input asp-for="IsActive" class="form-check-label">
        <label asp-for="IsActive" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">Kaydet</button>
</form>